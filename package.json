{
  "name": "@readonly-mcp/server",
  "version": "1.0.0",
  "description": "Security-hardened MCP server providing read-only CLI access for AI agents",
  "homepage": "https://github.com/readonly-mcp/readonly-mcp",
  "bugs": "https://github.com/readonly-mcp/readonly-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/readonly-mcp/readonly-mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "readonly-mcp": "index.mjs"
  },
  "files": [
    "index.mjs",
    "lib/",
    "tools/"
  ],
  "engines": {
    "node": ">=18",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "build": "pnpm run compile:ts && node scripts/stage-package.mjs",
    "compile:ts": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck:ts": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@gtbuchanan/tsconfig": "^0.2.0",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.3.0"
}
