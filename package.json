{
  "name": "@readonly-mcp/server",
  "version": "1.0.0",
  "description": "Security-hardened MCP server providing read-only CLI access for AI agents",
  "homepage": "https://github.com/readonly-mcp/readonly-mcp",
  "bugs": "https://github.com/readonly-mcp/readonly-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/readonly-mcp/readonly-mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "readonly-mcp": "./dist/source/index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "tools/"
  ],
  "scripts": {
    "build": "pnpm run compile:ts && node scripts/stage-package.ts",
    "compile:ts": "tsc -p tsconfig.build.json",
    "lint:eslint": "eslint",
    "test": "vitest run",
    "typecheck:ts": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@gtbuchanan/eslint-config": "catalog:",
    "@gtbuchanan/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=10.16.0"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "readonly-mcp": "./index.js"
    }
  }
}
